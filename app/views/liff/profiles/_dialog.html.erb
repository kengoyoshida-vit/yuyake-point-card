<dialog data-controller="profile-dialog"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg p-5 shadow-xl backdrop:bg-black/40">
  <h2 class="text-base font-semibold text-slate-900">はじめに教えてください</h2>
  <p class="mt-1 mb-4 text-xs text-slate-500">イベント運営の参考にさせていただきます。回答は任意で、あとからプロフィールで変更できます。</p>

  <%= render "liff/profiles/form", visitor: visitor %>

  <%= button_to "スキップ", skip_liff_profile_path, method: :post,
        form: { class: "mt-3" },
        class: "w-full rounded-md px-4 py-2 text-sm text-slate-500 underline" %>
</dialog>
