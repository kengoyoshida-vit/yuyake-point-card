<% unanswered = "未回答" %>
<h1 class="text-lg font-semibold text-slate-900">プロフィール設定</h1>
<p class="mt-1 text-sm text-slate-500">イベント運営の参考にさせていただきます。回答は任意です。</p>

<div class="mt-4 rounded-lg bg-white p-4 shadow">
  <dl class="space-y-4 text-sm">
    <div>
      <dt class="font-semibold text-slate-700">区分</dt>
      <dd class="mt-1 text-slate-900"><%= Visitor::CATEGORY_LABELS[@visitor.category] || unanswered %></dd>
    </div>

    <% if @visitor.sponsor_or_government? %>
      <div>
        <dt class="font-semibold text-slate-700">社名・団体名</dt>
        <dd class="mt-1 text-slate-900"><%= @visitor.company_name.presence || unanswered %></dd>
      </div>
    <% end %>

    <div>
      <dt class="font-semibold text-slate-700">性別</dt>
      <dd class="mt-1 text-slate-900"><%= Visitor::GENDER_LABELS[@visitor.gender] || unanswered %></dd>
    </div>

    <div>
      <dt class="font-semibold text-slate-700">年齢</dt>
      <dd class="mt-1 text-slate-900"><%= Visitor::AGE_BAND_LABELS[@visitor.age_band] || unanswered %></dd>
    </div>

    <div>
      <dt class="font-semibold text-slate-700">お住まい</dt>
      <dd class="mt-1 text-slate-900"><%= Visitor::RESIDENT_LABELS[@visitor.resident] || unanswered %></dd>
    </div>
  </dl>

  <%= link_to "編集する", edit_liff_profile_path, class: "mt-6 block w-full rounded-md bg-amber-500 px-4 py-2 text-center text-sm font-semibold text-white" %>
</div>

<%= link_to "マイページに戻る", liff_mypage_path, class: "mt-4 block text-center text-sm text-slate-500 underline" %>
